---
// A shop's checkout in the browser with DarkShell's payment sheet over it
// (app/src/PaySheetApp.svelte). The sheet slides up once the phone is in view.
import Icon from './Icon.astro';
---

<div class="stage">
	<div class="shop" aria-hidden="true">
		<div class="url">coffeelab.example/checkout</div>
		<div class="shop-body">
			<p class="brand">Coffee Lab</p>
			<div class="item"><span class="cup"></span><span><b>Flat white × 2</b><small>Oat milk</small></span><b>9.80</b></div>
			<div class="item"><span class="cup c2"></span><span><b>Almond croissant</b><small>Warm</small></span><b>2.60</b></div>
			<div class="total"><span>Total</span><b>12.40 sSCRT</b></div>
			<span class="pay-btn"><img src="/avatar.webp" alt="" />Pay with DarkShell</span>
		</div>
	</div>
	<div class="scrim"></div>
	<div class="sheet">
		<span class="grip"></span>
		<div class="top"><img src="/avatar.webp" alt="" /><b>DarkShell</b></div>
		<p class="amount"><span>12</span><em>.40</em><i>sSCRT</i></p>
		<p class="usd">≈ $1.06</p>
		<p class="to">to <b>Coffee Lab</b></p>
		<span class="confirm"><Icon name="fingerprint" size={16} stroke={1.8} />Confirm</span>
		<p class="details">Details <svg viewBox="0 0 24 24" width="11" height="11"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" /></svg></p>
	</div>
</div>

<style>
	.stage { position: absolute; inset: 0; }
	.shop { position: absolute; inset: 0; padding-top: 2.4em; background: #f3efe9; color: #1c1915; }
	.url { margin: 0.3em 0.9em; padding: 0.45em 0.8em; border-radius: 999px; background: #e4ded5; font-size: 0.7em; color: #5d554b; }
	.shop-body { padding: 0.9em 1.1em; }
	.brand { font-weight: 700; font-size: 1.25em; letter-spacing: -0.03em; margin-bottom: 0.9em; }
	.item { display: flex; align-items: center; gap: 0.7em; padding: 0.65em 0; border-bottom: 1px solid #ddd5ca; font-size: 0.86em; }
	.item > span:nth-child(2) { flex: 1; }
	.item small { display: block; color: #8a8175; font-size: 0.82em; }
	.cup { width: 2.4em; height: 2.4em; border-radius: 0.7em; background: radial-gradient(circle at 50% 45%, #f6e7d2 30%, #b88655 32%, #8a5a33 60%); flex-shrink: 0; }
	.c2 { background: linear-gradient(135deg, #e7b877, #b77a3c); }
	.total { display: flex; justify-content: space-between; margin-top: 1em; font-size: 0.92em; }
	.pay-btn { display: flex; align-items: center; justify-content: center; gap: 0.5em; margin-top: 1.1em; height: 2.8em; border-radius: 999px; background: #111; color: #fff; font-weight: 600; font-size: 0.86em; }
	.pay-btn img { width: 1.4em; height: 1.4em; border-radius: 999px; }

	.scrim { position: absolute; inset: 0; background: rgb(0 0 0 / 0.55); opacity: 0; transition: opacity 600ms var(--ease) 500ms; }
	.sheet {
		position: absolute;
		inset: auto 0 0;
		padding: 0.6em 1.3em 1.6em;
		border-radius: 1.6em 1.6em 0 0;
		background: #080808;
		border-top: 1px solid var(--border);
		box-shadow: 0 -1em 3em rgb(0 0 0 / 0.5);
		transform: translateY(105%);
		transition: transform 900ms cubic-bezier(0.32, 0.72, 0, 1) 500ms;
		text-align: center;
	}
	:global(.in) .scrim { opacity: 1; }
	:global(.in) .sheet { transform: none; }
	:global(.no-js) .scrim { opacity: 1; }
	:global(.no-js) .sheet { transform: none; }

	.grip { display: block; width: 2.6em; height: 0.25em; margin: 0 auto 0.8em; border-radius: 999px; background: var(--border-strong); }
	.top { display: flex; align-items: center; gap: 0.55em; font-size: 0.88em; }
	.top img { width: 1.7em; height: 1.7em; border-radius: 999px; }
	.top b { font-weight: 500; }
	.amount { margin-top: 1.5em; display: flex; justify-content: center; align-items: baseline; font-weight: 600; letter-spacing: -0.04em; line-height: 1; }
	.amount span { font-size: 3.2em; }
	.amount em { font-style: normal; font-size: 1.4em; color: var(--text-faint); }
	.amount i { font-style: normal; font-size: 1.05em; margin-left: 0.45em; color: var(--text-muted); font-weight: 500; letter-spacing: -0.01em; }
	.usd { margin-top: 0.55em; color: var(--text-faint); font-size: 0.86em; }
	.to { color: var(--text-muted); font-size: 0.86em; }
	.to b { color: var(--text); font-weight: 500; }
	.confirm { display: flex; align-items: center; justify-content: center; gap: 0.5em; margin-top: 1.4em; height: 3em; border-radius: 999px; background: var(--accent-strong); font-weight: 500; font-size: 0.9em; }
	.details { display: flex; align-items: center; justify-content: center; gap: 0.25em; margin-top: 0.8em; color: var(--text-muted); font-size: 0.75em; }

	@media (prefers-reduced-motion: reduce) {
		.scrim { opacity: 1; }
		.sheet { transform: none; }
	}
</style>
