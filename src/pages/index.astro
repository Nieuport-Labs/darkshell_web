---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Phone from '../components/Phone.astro';
import HomeScreen from '../components/HomeScreen.astro';
import SheetScreen from '../components/SheetScreen.astro';
import Code from '../components/Code.astro';
import { APK_URL, GITHUB, MIN_ANDROID, RELEASES } from '../config';

const SECURITY = [
	{ icon: 'key', title: 'Keys stay on the phone', text: 'Your recovery phrase is created on the device and encrypted with Argon2id and AES-GCM. It is never sent anywhere — not to us, not to anyone.' },
	{ icon: 'fingerprint', title: 'PIN and fingerprint', text: 'A 6-digit PIN unlocks the wallet; your fingerprint can stand in for it. Wrong guesses slow down, and the wallet locks itself when you look away.' },
	{ icon: 'alert', title: 'Emergency PIN', text: 'A second PIN that, under pressure, quietly wipes the real wallet, moves the money to a safe address you chose, and opens an ordinary-looking decoy.' },
	{ icon: 'onion', title: 'Tor built in', text: 'Turn it on and every request leaves the phone through Tor. Nothing is tried outside it while it connects — it fails closed.' },
	{ icon: 'server', title: 'No server of ours', text: 'DarkShell reads the chain from public nodes and recognises your incoming payments on the phone. There is no account, no backend, no analytics.' },
	{ icon: 'repeat', title: 'Sent once, never twice', text: 'Each transaction is signed once; a retry resends the same bytes, so a flaky connection can never make you pay twice.' },
] as const;

const FAQ = [
	{ q: 'Is DarkShell custodial?', a: 'No. The keys are generated and kept on your phone, and only you can move the money. That also means nobody — including us — can recover a lost recovery phrase.' },
	{ q: 'What is sSCRT?', a: 'SCRT wrapped as a private SNIP-20 token. Balances and transfers are encrypted on Secret Network, so only you (and whoever you choose) can see them. One sSCRT is always worth one SCRT.' },
	{ q: 'Do I need SCRT to pay network fees?', a: 'No. Fees are paid from gas credits — a fee grant from an on-chain vault. They are topped up from your balance only when it can easily spare it, and never in a way that blocks a payment. Your very first top-up has its fee paid by a faucet.' },
	{ q: 'Can I use my Keplr recovery phrase?', a: 'Yes. Account 1 is the same address Keplr shows, and restoring a phrase also finds its other accounts that hold funds.' },
	{ q: 'How do I pay in a token I don’t hold?', a: 'Just pay the invoice. DarkShell swaps sSCRT on ShadeSwap inside the same transaction, with a minimum return, so the recipient gets exactly the amount and token they asked for.' },
	{ q: 'Is there an iPhone version?', a: `Not yet. DarkShell runs on ${MIN_ANDROID} and newer.` },
	{ q: 'Why is it not on Google Play?', a: 'It is distributed as a signed APK from GitHub for now. Android asks once to allow installs from your browser; updates must be signed with the same key, so a tampered build can’t replace yours.' },
] as const;

const snippet = `import { checkout } from 'secret-pay/checkout';

const c = checkout(invoice, {
  returnUrl: 'https://shop.example/order/42',
});

payButton.onclick = () => (location.href = c.url);`;
---

<Base>
	<!-- ------------------------------ hero ------------------------------ -->
	<section class="hero">
		<div class="glow" aria-hidden="true"></div>
		<div class="shell hero-grid">
			<div class="hero-copy">
				<span class="eyebrow reveal">The private wallet for Secret Network</span>
				<h1 class="display reveal" style="--delay: 80ms">Money that minds its own&nbsp;business.</h1>
				<p class="lead reveal" style="--delay: 160ms">
					DarkShell is a private sSCRT account for Android. One encrypted balance, invoices payable in any token, tap&#8209;to&#8209;pay — and network fees
					taken care of.
				</p>
				<div class="cta reveal" style="--delay: 240ms">
					<a class="btn btn-primary" href={APK_URL}>
						Download for Android
						<span class="knob"><Icon name="down" size={16} stroke={2} /></span>
					</a>
					<a class="btn btn-ghost btn-plain" href="#features">See what it does</a>
				</div>
				<p class="fine faint reveal" style="--delay: 320ms">
					<Icon name="android" size={16} />
					{MIN_ANDROID}+ · free · <a class="text-link" href={GITHUB}>source on GitHub</a>
				</p>
			</div>

			<div class="hero-art reveal" style="--delay: 200ms">
				<Phone label="DarkShell's Home screen: a private balance of 1,284.50 sSCRT with recent activity">
					<HomeScreen />
				</Phone>
				<div class="toast" aria-hidden="true">
					<span class="toast-ic"><Icon name="down" size={16} stroke={2} /></span>
					<span><b>+25.00 sSCRT</b><small>Received privately</small></span>
				</div>
				<div class="chip" aria-hidden="true">
					<span class="dot"></span>Network fee · from gas credits
				</div>
			</div>
		</div>
	</section>

	<!-- ------------------------------ facts ----------------------------- -->
	<section class="shell facts" aria-label="At a glance">
		<div class="reveal"><b>Encrypted</b><span>balances and transfers on chain</span></div>
		<div class="reveal" style="--delay: 60ms"><b>0 SCRT</b><span>needed for network fees</span></div>
		<div class="reveal" style="--delay: 120ms"><b>66 tokens</b><span>you can pay invoices in</span></div>
		<div class="reveal" style="--delay: 180ms"><b>No server</b><span>between you and the chain</span></div>
	</section>

	<!-- ----------------------------- features ---------------------------- -->
	<section class="section shell" id="features">
		<div class="section-head">
			<span class="eyebrow reveal">What it does</span>
			<h2 class="h2 reveal">A bank account’s ease, a&nbsp;cash&nbsp;envelope’s&nbsp;privacy.</h2>
			<p class="lead reveal">One asset, one balance, and everything you would expect from an account — without anyone watching what you do with it.</p>
		</div>

		<div class="bento">
			<article class="bezel b-wide reveal">
				<div class="core card">
					<div class="card-text">
						<span class="ic"><Icon name="shield" /></span>
						<h3 class="h3">One private balance</h3>
						<p class="muted">
							Your money sits in sSCRT, encrypted on Secret Network. Public SCRT that arrives and your staking rewards count too — a payment that needs them claims and
							wraps them in the same transaction.
						</p>
					</div>
					<div class="mini-balance" aria-hidden="true">
						<p class="faint">Balance</p>
						<p class="mb-amt"><span>1 284</span><em>.5021</em></p>
						<div class="mb-rows">
							<span><i class="s1"></i>sSCRT <b>1 158.21</b></span>
							<span><i class="s2"></i>Public SCRT <b>125.46</b></span>
							<span><i class="s3"></i>Rewards <b>0.8321</b></span>
						</div>
					</div>
				</div>
			</article>

			<article class="bezel reveal" style="--delay: 60ms">
				<div class="core card">
					<span class="ic"><Icon name="fuel" /></span>
					<h3 class="h3">Fees taken care of</h3>
					<p class="muted">Network fees come out of prepaid gas credits, not your SCRT. They top themselves up only from money you won’t miss.</p>
				</div>
			</article>

			<article class="bezel reveal">
				<div class="core card">
					<span class="ic"><Icon name="swap" /></span>
					<h3 class="h3">Pay in any token</h3>
					<p class="muted">An invoice in USDC, ATOM or one of 66 tokens? DarkShell swaps on ShadeSwap in the same transaction. They get exactly what they asked for.</p>
				</div>
			</article>

			<article class="bezel reveal" style="--delay: 60ms">
				<div class="core card">
					<span class="ic"><Icon name="receipt" /></span>
					<h3 class="h3">Invoices that know when they’re paid</h3>
					<p class="muted">Ask for an amount with a QR code or a link. The invoice turns paid by itself the moment the money lands.</p>
				</div>
			</article>

			<article class="bezel reveal" style="--delay: 120ms">
				<div class="core card">
					<span class="ic"><Icon name="bell" /></span>
					<h3 class="h3">Know the moment you’re paid</h3>
					<p class="muted">Incoming payments are recognised on your phone from encrypted on-chain notifications — no server learns which ones are yours.</p>
				</div>
			</article>

			<article class="bezel reveal">
				<div class="core card">
					<span class="ic"><Icon name="sprout" /></span>
					<h3 class="h3">Earn from the same balance</h3>
					<p class="muted">Stake straight from your private balance in one transaction. Rewards are collected and made private again with a tap.</p>
				</div>
			</article>

			<article class="bezel b-wide reveal" style="--delay: 60ms">
				<div class="core card split">
					<div class="card-text">
						<span class="ic"><Icon name="layers" /></span>
						<h3 class="h3">As simple as you want it</h3>
						<p class="muted">
							Choose the simple app when you set it up — just your balance, Send and Receive — or the full one with invoices, activity and staking. Switch any time.
						</p>
					</div>
					<div class="simple" aria-hidden="true">
						<p class="faint">Balance</p>
						<p class="s-amt">284<em>.50</em></p>
						<p class="faint small">sSCRT · $24.33</p>
						<div class="s-btns"><span class="p">Send</span><span>Receive</span></div>
					</div>
				</div>
			</article>
		</div>
	</section>

	<!-- ------------------------------- pay ------------------------------- -->
	<section class="pay-sec" id="pay">
		<div class="shell pay-grid">
			<div class="pay-art reveal">
				<Phone class="pay-phone" label="A shop's checkout page with DarkShell's payment sheet: 12.40 sSCRT to Coffee Lab, Confirm with fingerprint">
					<SheetScreen />
				</Phone>
			</div>
			<div class="pay-copy">
				<span class="eyebrow reveal">Checkout</span>
				<h2 class="h2 reveal">Tap. Touch. Paid.</h2>
				<p class="lead reveal">
					When a shop asks for a payment, DarkShell slides up over the page — the sSCRT it costs first and largest, then who gets it. Confirm with your fingerprint and
					you’re back on the page.
				</p>
				<ol class="steps">
					<li class="reveal">
						<span class="n">1</span>
						<div><b>Pay with DarkShell</b><p class="muted">A button on the website, a QR code at the counter, or a link in a chat.</p></div>
					</li>
					<li class="reveal" style="--delay: 60ms">
						<span class="n">2</span>
						<div><b>See exactly what it costs</b><p class="muted">The amount in sSCRT — even when the shop asked for another token — and who it goes to.</p></div>
					</li>
					<li class="reveal" style="--delay: 120ms">
						<span class="n">3</span>
						<div><b>Confirm with your fingerprint</b><p class="muted">Paid in one transaction, in about six seconds, and the shop sees it on chain.</p></div>
					</li>
				</ol>
				<div class="nfc reveal">
					<span class="nfc-ic"><Icon name="nfc" /></span>
					<div>
						<b>Or just hold the phones together</b>
						<p class="muted">An open invoice — or your Receive screen — is shared over NFC. The other phone opens it like a contactless sticker.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- --------------------------- anywhere ------------------------------ -->
	<section class="section shell anywhere">
		<div class="section-head center">
			<span class="eyebrow reveal">Beyond Secret</span>
			<h2 class="h2 reveal">Pay the rest of the world from one private balance.</h2>
			<p class="lead reveal">Scan a Lightning invoice or a Bitcoin, Ethereum or Monero address. DarkShell pays it from sSCRT in a single Secret transaction.</p>
		</div>
		<div class="rails reveal">
			<span><Icon name="bolt" size={18} />Lightning</span>
			<span><b class="glyph">₿</b>Bitcoin</span>
			<span><b class="glyph">Ξ</b>Ethereum · Arbitrum · Base · Optimism</span>
			<span><b class="glyph">ɱ</b>Monero</span>
			<span><Icon name="swap" size={18} />Osmosis · Cosmos Hub over IBC</span>
		</div>
		<p class="ff faint reveal">Lightning and other chains are Powered by FixedFloat. Every address is checked by its own checksum before anything is sent.</p>
	</section>

	<!-- ----------------------------- security ---------------------------- -->
	<section class="section shell" id="security">
		<div class="section-head">
			<span class="eyebrow reveal">Security</span>
			<h2 class="h2 reveal">Built for the day something goes wrong.</h2>
			<p class="lead reveal">Privacy is only worth as much as the wallet that keeps it. These are the parts you hopefully never notice.</p>
		</div>
		<div class="sec-grid">
			{
				SECURITY.map((s, i) => (
					<article class="sec reveal" style={`--delay: ${(i % 3) * 60}ms`}>
						<span class="ic">
							<Icon name={s.icon} />
						</span>
						<h3 class="h3">{s.title}</h3>
						<p class="muted">{s.text}</p>
					</article>
				))
			}
		</div>
	</section>

	<!-- ---------------------------- developers --------------------------- -->
	<section class="shell dev-band">
		<div class="bezel reveal">
			<div class="core dev">
				<div class="dev-copy">
					<span class="eyebrow">For developers</span>
					<h2 class="h2">Accept private payments in five lines.</h2>
					<p class="lead">
						<code>secret-pay</code> is an open payment-request standard for Secret Network with a zero-dependency library. Add a button; the payer’s wallet does the rest
						and brings them back.
					</p>
					<a class="btn btn-ghost" href="/developers">
						Read the guide
						<span class="knob"><Icon name="arrow" size={16} stroke={2} /></span>
					</a>
				</div>
				<Code code={snippet} lang="ts" />
			</div>
		</div>
	</section>

	<!-- -------------------------------- faq ------------------------------ -->
	<section class="section shell faq-sec" id="faq">
		<div class="section-head">
			<span class="eyebrow reveal">Questions</span>
			<h2 class="h2 reveal">Good to know.</h2>
		</div>
		<div class="faq">
			{
				FAQ.map((f) => (
					<details class="reveal">
						<summary>
							{f.q}
							<span class="plus" aria-hidden="true">
								<Icon name="plus" size={18} />
							</span>
						</summary>
						<p class="muted">{f.a}</p>
					</details>
				))
			}
		</div>
	</section>

	<!-- ----------------------------- download ---------------------------- -->
	<section class="shell final" id="download">
		<div class="final-in reveal">
			<div class="glow2" aria-hidden="true"></div>
			<img src="/avatar.webp" alt="" width="72" height="72" />
			<h2 class="h2">Take your money private.</h2>
			<p class="lead">Free for {MIN_ANDROID} and newer. Set up in a minute — no account, no email, no KYC.</p>
			<div class="cta center">
				<a class="btn btn-primary" href={APK_URL}>
					Download the APK
					<span class="knob"><Icon name="down" size={16} stroke={2} /></span>
				</a>
				<a class="btn btn-ghost btn-plain" href={RELEASES}>Release notes</a>
			</div>
			<p class="faint small">Android asks once to allow installs from your browser. Only install DarkShell from this site or its GitHub releases.</p>
		</div>
	</section>
</Base>

<style>
	/* hero */
	.hero { position: relative; padding: clamp(8rem, 16vw, 10.5rem) 0 clamp(3rem, 7vw, 5rem); overflow: hidden; }
	.glow {
		position: absolute;
		inset: -10% -20% auto auto;
		width: min(900px, 110vw);
		aspect-ratio: 1;
		background: radial-gradient(circle at 60% 40%, rgb(255 57 18 / 0.22), transparent 58%);
		filter: blur(40px);
		pointer-events: none;
	}
	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px);
		background-size: 64px 64px;
		mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 20%, transparent 75%);
		opacity: 0.35;
		pointer-events: none;
	}
	.hero-grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1.08fr 0.92fr; align-items: center; gap: 3rem; }
	.hero-copy { display: grid; gap: 1.6rem; justify-items: start; }
	.hero-copy .lead { max-width: 34rem; }
	.cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }
	.cta.center { justify-content: center; }
	.fine { display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; }

	.hero-art { position: relative; display: grid; place-items: center; padding: 1rem 0; }
	.hero-art :global(.phone) { --w: min(310px, 74vw); transform: rotate(-2deg); }
	.toast {
		position: absolute;
		bottom: 30%;
		left: max(-1rem, 50% - 15.5rem);
		display: flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.7rem 1rem 0.7rem 0.7rem;
		border-radius: 1.1rem;
		border: 1px solid var(--border-strong);
		background: rgb(27 27 27 / 0.86);
		-webkit-backdrop-filter: blur(16px);
		backdrop-filter: blur(16px);
		box-shadow: 0 20px 50px -20px #000;
		animation: settle 1s var(--ease) 0.9s backwards;
	}
	.toast b { display: block; font-weight: 600; font-size: 0.95rem; font-variant-numeric: tabular-nums; }
	.toast small { color: var(--text-muted); font-size: 0.8rem; }
	.toast-ic { display: grid; place-items: center; width: 2.2rem; height: 2.2rem; border-radius: 999px; background: rgb(33 193 122 / 0.15); color: var(--positive); }
	.chip {
		position: absolute;
		top: 22%;
		right: max(-1rem, 50% - 16rem);
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.55rem 0.9rem;
		border-radius: 999px;
		border: 1px solid var(--border-strong);
		background: rgb(27 27 27 / 0.86);
		-webkit-backdrop-filter: blur(16px);
		backdrop-filter: blur(16px);
		font-size: 0.85rem;
		color: var(--text-muted);
		animation: settle 1s var(--ease) 1.1s backwards;
	}
	.chip .dot { width: 0.45rem; height: 0.45rem; border-radius: 999px; background: var(--positive); }
	@keyframes settle { from { opacity: 0; transform: translateY(12px) scale(0.97); } }

	/* facts */
	.facts { display: grid; grid-template-columns: repeat(4, 1fr); border-block: 1px solid var(--border); }
	.facts > div { display: grid; gap: 0.2rem; padding: 1.6rem 1.25rem; }
	.facts > div + div { border-left: 1px solid var(--border); }
	.facts b { font-size: 1.5rem; font-weight: 600; letter-spacing: -0.03em; }
	.facts span { color: var(--text-faint); font-size: 0.92rem; }

	/* bento */
	.bento { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
	.b-wide { grid-column: span 2; }
	.card { display: grid; align-content: start; gap: 0.75rem; padding: 1.75rem; min-height: 15rem; }
	.card .muted { font-size: 0.98rem; line-height: 1.6; }
	.ic { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; margin-bottom: 0.6rem; border-radius: 0.9rem; background: var(--accent-soft); color: var(--accent); }
	.b-wide .card { grid-template-columns: 1.1fr 0.9fr; align-items: center; gap: 2rem; }
	.card-text { display: grid; gap: 0.75rem; align-content: start; }

	.mini-balance { padding: 1.25rem; border-radius: 1.25rem; background: var(--surface-1); border: 1px solid var(--border); }
	.mini-balance .faint { font-size: 0.85rem; }
	.mb-amt { font-weight: 600; letter-spacing: -0.04em; line-height: 1; margin: 0.4rem 0 1rem; font-variant-numeric: tabular-nums; }
	.mb-amt span { font-size: 2.6rem; }
	.mb-amt em { font-style: normal; font-size: 1.2rem; color: var(--text-faint); }
	.mb-rows { display: grid; gap: 0.55rem; font-size: 0.88rem; color: var(--text-muted); }
	.mb-rows span { display: flex; align-items: center; gap: 0.55rem; }
	.mb-rows b { margin-left: auto; color: var(--text); font-weight: 500; font-variant-numeric: tabular-nums; }
	.mb-rows i { width: 0.55rem; height: 0.55rem; border-radius: 999px; }
	.s1 { background: var(--accent); }
	.s2 { background: #8a8a8a; }
	.s3 { background: var(--positive); }

	.simple { text-align: center; padding: 1.4rem 1rem; border-radius: 1.25rem; background: var(--surface-1); border: 1px solid var(--border); }
	.simple .faint { font-size: 0.85rem; }
	.s-amt { font-size: 3rem; font-weight: 600; letter-spacing: -0.045em; line-height: 1.1; }
	.s-amt em { font-style: normal; font-size: 1.3rem; color: var(--text-faint); }
	.small { font-size: 0.85rem; }
	.s-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-top: 1.1rem; }
	.s-btns span { padding: 0.65rem; border-radius: 999px; background: var(--surface-2); font-size: 0.9rem; font-weight: 500; }
	.s-btns .p { background: var(--accent-strong); }

	/* pay */
	.pay-sec { padding-block: clamp(5rem, 10vw, 8rem); background: linear-gradient(180deg, transparent, #0c0c0c 18%, #0c0c0c 82%, transparent); }
	.pay-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2.5rem, 6vw, 5rem); align-items: center; }
	.pay-art { display: grid; place-items: center; }
	.pay-art :global(.phone) { --w: min(310px, 74vw); }
	.pay-copy { display: grid; gap: 1.5rem; justify-items: start; }
	.steps { list-style: none; margin: 0.5rem 0 0; padding: 0; display: grid; gap: 1.1rem; }
	.steps li { display: flex; gap: 1rem; }
	.steps b { font-weight: 500; font-size: 1.05rem; }
	.steps p { font-size: 0.97rem; margin-top: 0.15rem; }
	.n { display: grid; place-items: center; flex-shrink: 0; width: 2rem; height: 2rem; border-radius: 999px; border: 1px solid var(--border-strong); color: var(--text-muted); font-size: 0.9rem; font-variant-numeric: tabular-nums; }
	.nfc { display: flex; gap: 1rem; align-items: flex-start; padding: 1.2rem 1.3rem; border-radius: 1.25rem; border: 1px solid var(--border); background: var(--surface-1); }
	.nfc b { font-weight: 500; }
	.nfc p { font-size: 0.95rem; margin-top: 0.2rem; }
	.nfc-ic { display: grid; place-items: center; flex-shrink: 0; width: 2.5rem; height: 2.5rem; border-radius: 999px; background: var(--accent-soft); color: var(--accent); }

	/* anywhere */
	.rails { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; }
	.rails span { display: inline-flex; align-items: center; gap: 0.55rem; padding: 0.75rem 1.15rem; border-radius: 999px; border: 1px solid var(--border); background: var(--surface-1); color: var(--text-muted); }
	.glyph { width: 18px; text-align: center; font-weight: 600; color: var(--text); }
	.ff { text-align: center; font-size: 0.88rem; margin-top: 1.5rem; }

	/* security */
	.sec-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--border); }
	.sec { display: grid; gap: 0.6rem; align-content: start; padding: 2rem 1.75rem 2.25rem 0; border-bottom: 1px solid var(--border); }
	.sec:not(:nth-child(3n + 1)) { padding-left: 1.75rem; border-left: 1px solid var(--border); }
